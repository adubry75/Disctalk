<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Disctalk.Core</RootNamespace>
    <AssemblyName>Disctalk.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legacy models (Models/) and DiscordApiClient stay on Newtonsoft so the JSON Disctalk
         writes to MySQL is byte-for-byte what it always was. New code uses System.Text.Json. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Disctalk.Tests" />
  </ItemGroup>

</Project>
