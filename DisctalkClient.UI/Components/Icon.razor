@* Inline stroke icons (Lucide-style geometry), so the library ships no icon font. *@
<svg class="dt-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "hash": <path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18" /> break;
        case "announce": <path d="m3 11 18-5v12L3 14v-3z" /><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" /> break;
        case "voice": <path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.5 8.5a5 5 0 0 1 0 7" /> break;
        case "forum": <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /> break;
        case "menu": <path d="M4 6h16M4 12h16M4 18h16" /> break;
        case "users": <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /> break;
        case "settings": <path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6" /> break;
        case "reply": <path d="M9 17 4 12l5-5" /><path d="M20 18v-2a4 4 0 0 0-4-4H4" /> break;
        case "edit": <path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" /> break;
        case "trash": <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /> break;
        case "smile": <circle cx="12" cy="12" r="10" /><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01" /> break;
        case "x": <path d="M18 6 6 18M6 6l12 12" /> break;
        case "send": <path d="M22 2 11 13" /><path d="M22 2 15 22 11 13 2 9 22 2Z" /> break;
        case "plus": <circle cx="12" cy="12" r="10" /><path d="M12 8v8M8 12h8" /> break;
        case "chevron": <path d="m6 9 6 6 6-6" /> break;
        case "bot": <rect x="3" y="11" width="18" height="10" rx="2" /><circle cx="12" cy="5" r="2" /><path d="M12 7v4M8 16h.01M16 16h.01" /> break;
        case "webhook": <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /> break;
        case "logout": <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /> break;
        case "file": <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" /><path d="M14 2v6h6" /> break;
        case "cat":
            <path d="M12 5c.67 0 1.35.09 2 .26 1.78-2 5.03-2.84 6.42-2.26 1.4.58-.42 7-.42 7 .57 1.07 1 2.24 1 3.44C21 17.9 16.97 21 12 21s-9-3-9-7.56c0-1.25.5-2.4 1-3.44 0 0-1.89-6.42-.5-7 1.39-.58 4.72.23 6.5 2.23A9.04 9.04 0 0 1 12 5Z" />
            <path d="M8 14v.5M16 14v.5M11.25 16.25h1.5L12 17l-.75-.75Z" />
            break;
        case "paw":
            <g fill="currentColor" stroke="none">
                <ellipse cx="12" cy="16" rx="5" ry="4.2" /><ellipse cx="5.2" cy="10.5" rx="2.1" ry="2.6" /><ellipse cx="18.8" cy="10.5" rx="2.1" ry="2.6" />
                <ellipse cx="9" cy="5.6" rx="2.1" ry="2.7" /><ellipse cx="15" cy="5.6" rx="2.1" ry="2.7" />
            </g>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }
}
